# Environment variables for zbmaus-humanoid (Vercel)
# Copy to Vercel project settings.

# LLM proxy used by /api/chat (fallback when relay is not configured)
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo

# Option A: public relay to the OMB bot (ZbmausHumanoid-Vercel).
# Set OMB_RELAY_URL to the public URL of a reverse proxy on the VPS that
# forwards to the bot webhook (127.0.0.1:8800/hooks/...). When set, /api/chat
# talks to the real bot instead of the generic LLM.
# OMB_RELAY_URL=
# OMB_WEBHOOK_BEARER=

# Option B (alternative): admin token for OMB bot messages API
# OMB_BOT_ID=c3ec552d-e63d-45cd-ba95-ce0f6e95d3f9
# OMB_ADMIN_TOKEN=
